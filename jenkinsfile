pipeline {
    agent any
    stages {
        stage('Pull') {
            steps {
                sh '''
                    echo "SCM checkout"

                    if [ -d "backend-test/.git" ]; then
                        echo "Repo exists, resetting git"
                        cd backend-test
                        git reset --hard
                        git clean -fd
                        git pull origin main
                    else
                        echo "Repo does not exist so cloning"
                        git clone https://github.com/alwinjames-alt/posts_node.git backend-test
                    fi
                '''
            }
        }
        stage('Test'){
            steps {
                sh '''
                    echo "Testing the backend code"
                    echo "No Errors"
                '''
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    echo "Starting Docker build..."

                    sh 'cd backend-test'

                    def version = sh(script: "jq -r '.version' backend-test/package.json", returnStdout: true).trim()
                    echo "App version: ${version}"

                    sh "docker build -t alwinjames313/backend-test:${version} -f backend-test/dockerfile backend-test"

                    sh "docker tag alwinjames313/backend-test:${version} alwinjames313/backend-test:latest"

                    env.IMAGE_VERSION = version

                    echo "Docker image built successfully!"
                }
            }
        }
        stage('Docker Deploy') {
            steps {
                script {
                    echo "Starting Docker deploy..."

                    sh "docker login -u alwinjames313 -p Alwin@6282"

                    sh "docker push alwinjames313/backend-test:${env.IMAGE_VERSION}"
                    sh "docker push alwinjames313/backend-test:latest"

                    echo "Docker images pushed successfully!"
                }
            }
        }
        stage('EC2 Deploy') {
            steps {
                sshagent (credentials: ['ec2-ssh-key']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ubuntu@13.126.127.121 "  
                        echo 'Deploying to EC2 instance'
                        docker login -u alwinjames313 -p Alwin@6282
                        docker pull alwinjames313/backend-test:latest
                        docker run -d -p 8080:8080 alwinjames313/backend-test:latest
                    '''
                }
            }
        }
        stage('Post deployment Test'){
            steps {
                script {
                    echo "Post deployment testing on /readiness..."

                    def status = sh(
                        script: "curl -s -o /dev/null -w '%{http_code}' http://13.126.127.121:8080/readiness",
                        returnStdout: true
                    ).trim()

                    echo "HTTP Status Code: ${status}"

                    if (status == '200') {
                        echo "Deployment successful! /readiness returned 200."
                    } else {
                        error "Deployment failed! /readiness returned HTTP ${status}"
                    }
                }
            }
        }
    }
}