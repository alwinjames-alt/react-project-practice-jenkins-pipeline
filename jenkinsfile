pipeline {
    agent any
    stages {
        stage('Pull') {
            steps {
                sh '''
                    echo "SCM checkout"

                    if [ -d "react-project/.git" ]; then
                        echo "Repo exists, resetting git"
                        cd react-project
                        git reset --hard
                        git clean -fd
                        git pull origin master
                    else
                        echo "Repo does not exist so cloning"
                        git clone https://github.com/alwinjames-alt/Backend-test.git backend-test
                    fi
                '''
            }
        }
        stage('Test'){
            steps {
                sh '''
                    echo "Testing the backend code"
                    echo "No Errors"
                '''
            }
        }
        stage('Docker Build') {
            steps {
                script {
                    echo "Starting Docker build..."

                    // Navigate to your app folder
                    sh 'cd backend-test'

                    // Extract version from package.json
                    def version = sh(script: "jq -r '.version' package.json", returnStdout: true).trim()
                    echo "App version: ${version}"

                    // Build Docker image with version tag
                    sh "docker build -t backend-test:${version} ."

                    // Tag also as latest
                    sh "docker tag backend-test:${version} backend-test:latest"

                    // Save the version in an environment variable for next stage
                    env.IMAGE_VERSION = version

                    echo "Docker image built successfully!"
                }
            }
        }
        stage('Docker Deploy') {
            steps {
                script {
                    echo "Starting Docker deploy..."

                    // Login to Docker Hub (use credentials or token safely)
                    sh "docker login -u alwinjames313 -p Alwin@6282"

                    // Push both versioned and latest images
                    sh "docker push backend-test:${env.IMAGE_VERSION}"
                    sh "docker push backend-test:latest"

                    echo "Docker images pushed successfully!"
                }
            }
        }
        stage('EC2 Deploy') {
            steps {
                sshagent (credentials: ['ec2-ssh-key']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ubuntu@13.126.127.121 "  
                        echo 'Deploying to EC2 instance'
                        docker login -u alwinjames313 -p Alwin@6282
                        docker pull backend-test:latest
                        docker run -d -p 8080:8080 backend-test:latest
                    '''
                }
            }
        }
        stage('Post deployment Test'){
            steps {
                script {
                    echo "Post deployment testing on /readiness..."

                    // Make a curl request and get HTTP status code
                    def status = sh(
                        script: "curl -s -o /dev/null -w '%{http_code}' http://13.126.127.121:8080/readiness",
                        returnStdout: true
                    ).trim()

                    echo "HTTP Status Code: ${status}"

                    if (status == '200') {
                        echo "Deployment successful! /readiness returned 200."
                    } else {
                        error "Deployment failed! /readiness returned HTTP ${status}"
                    }
                }
            }
        }
    }
}